    def draw_help(self, h, w):
        bw, bh = min(w - 4, 112), min(h - 2, len(self.HELP) + 4)
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for i in range(bh):
            self.put(y0 + i, x0, ' ' * bw)
        self.box(y0, x0, bh, bw, 'Explain  (any key closes)')
        for i, (k, text) in enumerate(self.HELP[:bh - 4]):
            self.put(y0 + 2 + i, x0 + 2, k.ljust(11), self.A['orange'])
            self.put(y0 + 2 + i, x0 + 13, text, 0, bw - 15)

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 16 or w < 60:
            self.put(0, 0, f'threadwatch top needs at least 60x16 (now {w}x{h})', self.A['yellow'])
            scr.refresh()
            return
        y = self.draw_header(0, w)
        rows = self.visible_rows()
        insp_h = 7
        table_h = h - y - insp_h - 1
        self.draw_table(y, table_h, w, rows)
        sel = next((r for r in rows if r['key'] == self.sel_key), None)
        self.draw_inspector(y + table_h, insp_h, w, sel)
        self.draw_footer(h - 1, w)
        if self.help:
            self.draw_help(h, w)
        scr.refresh()

    # -------------------------------------------------- input and main loop
    def move(self, delta):
        rows = self.visible_rows()
        if not rows:
            return
        keys = [r['key'] for r in rows]
        i = keys.index(self.sel_key) if self.sel_key in keys else 0
        self.sel_key = keys[max(0, min(len(keys) - 1, i + delta))]

    def key(self, ch):
        c = self.c
        if self.help:
            self.help = False
            return True
        if ch in (ord('q'), ord('Q'), 27):
            return False
        page = max(1, self.scr.getmaxyx()[0] - 20)
        moves = {c.KEY_UP: -1, ord('k'): -1, c.KEY_DOWN: 1, ord('j'): 1, c.KEY_PPAGE: -page, c.KEY_NPAGE: page,
                 c.KEY_HOME: -10 ** 6, c.KEY_END: 10 ** 6}
        if ch in moves:
            self.move(moves[ch])
        elif ch == ord('s'):
            self.sort = SORTS[(SORTS.index(self.sort) + 1) % len(SORTS)]
        elif ch == ord('a'):
            self.show_all = not self.show_all
        elif ch in (ord('p'), ord(' ')):
            self.paused = not self.paused
        elif ch in (ord('+'), ord('=')):
            self.model.interval = min(10.0, self.model.interval * 2)
        elif ch in (ord('-'), ord('_')):
            self.model.interval = max(0.25, self.model.interval / 2)
        elif ch == ord('?'):
            self.help = True
        elif ch == ord('r'):
            if self.rec:
                self.stop_recording()
            else:
                self.start_recording()
        return True

    def start_recording(self):
        m, args = self.model, self.args
        if self.rec or not m.pid or m.exited:
            if not m.pid or m.exited:
                self.notice = ('nothing to record yet', time.monotonic() + 5)
            return
        name = re.sub(r'[^A-Za-z0-9._-]+', '_', m.comm) or 'target'
        base = os.path.join(args.rec_dir, f'threadwatch-{name}-{time.strftime("%Y%m%d-%H%M%S")}')
        out, n = base, 2
        while os.path.exists(out):
            out, n = f'{base}-{n}', n + 1
        try:
            rec = Recorder(m.pid, out, args.rec_interval, args, args.syscalls, source='top')
        except (OSError, ProcessLookupError) as e:
            self.notice = (f'cannot record: {e}', time.monotonic() + 10)
            return
        self.rec = RecThread(rec)
        self.rec.start()
        self.notice = (f'recording to {os.path.basename(out)}/', time.monotonic() + 5)

    def stop_recording(self, why=''):
        """Stop (if running) or collect (if it ended on its own) the recording, and say where it went."""
        if not self.rec:
            return
        rt, self.rec = self.rec, None
        rt.stop_evt.set()
        rt.join(5.0)
        rec = rt.rec
        secs = (rec.meta.get('end_epoch') or time.time()) - rec.meta['start_epoch']
        self.saved.append((rec.out, secs, rec.nsamples))
        why = why or (f'stopped: {rt.ended}' if rt.ended else '')
        self.notice = (f"saved {secs:.0f} s to {os.path.basename(rec.out)}/" + (f' ({why})' if why else ''),
                       time.monotonic() + 20)

    def maybe_switch(self):
        """Default (Steam) mode: move to another process of the same game when it is clearly busier,
        e.g. from a launcher to the game it started. Checked every 5 s."""
        m, now = self.model, time.monotonic()
        if not is_auto(self.args) or not m.pid or m.exited or now < self.sw_next:
            return
        self.sw_next = now + 5.0
        table = proc_table()
        if m.pid not in table:
            return  # the target just exited; the next sample notices and handles it
        appid = self.args.appid or steam_appid(m.pid)
        ticks = {p: table[p][2] for p, _, _ in steam_candidates(table, appid)}
        if m.pid in table:
            ticks[m.pid] = table[m.pid][2]
        prev, self.sw_prev = self.sw_prev, (now, ticks)
        if not prev:
            return
        dt = now - prev[0]
        delta = {p: t - prev[1].get(p, t) for p, t in ticks.items()}
        best = max((p for p in delta if p != m.pid), key=lambda p: delta[p], default=None)
        if best and delta[best] > max(2 * delta.get(m.pid, 0), 0.5 * CLK_TCK * dt):
            old = m.comm
            self.stop_recording(f'target changed to {table[best][1]}')
            m.reset(best)
            self.sel_key, self.offset, self.sw_prev = None, 0, None
            self.notice = (f'switched from {old} to busier {m.comm}', now + 15)
            if self.args.record:
                self.start_recording()

    def update_syscall_targets(self):
        if not self.sys or not self.model.pid:
            return
        m = self.model
        tg = {(m.pid, m.pid)}
        if self.sel_key:
            tg.add(self.sel_key)
        hot = sorted((r for r in m.rows if r['proc'] == 'target'), key=lambda r: -r['avg'])[:2]
        tg.update(r['key'] for r in hot)
        self.sys.set_targets(sorted(tg))

    def run(self):
        try:
            return self._run()
        finally:
            self.stop_recording('quit')  # never lose a recording on q, Ctrl+C or SIGTERM

    def _run(self):
        self.start_finder()
        self.scr.timeout(100)
        next_sample = 0.0
        while not _stop:
            if self.rec and not self.rec.is_alive():
                self.stop_recording()  # it ended on its own (target exited)
            self.poll_target()
            self.maybe_switch()
            now = time.monotonic()
            if self.model.pid and not self.model.exited and not self.paused and now >= next_sample:
                self.model.sample()
                next_sample = now + self.model.interval
                self.update_syscall_targets()
            self.draw()
            ch = self.scr.getch()
            while ch != -1:
                if ch == self.c.KEY_RESIZE:
                    pass
                elif not self.key(ch):
                    return 0
                self.update_syscall_targets()
                ch = self.scr.getch() if not self.help else -1
                if ch != -1 or self.help:
                    self.draw()
        return 0


def cmd_top(args):
    import curses
    signal.signal(signal.SIGTERM, _on_signal)
    if not sys.stdout.isatty():
        print('threadwatch top needs a terminal', file=sys.stderr)
        return 1
    os.environ.setdefault('ESCDELAY', '25')  # Esc quits; curses otherwise waits 1 s to rule out an escape sequence
    holder = {}

    def go(scr):
        holder['ui'] = TopUI(scr, args)
        return holder['ui'].run()
    rc = 0
    try:
        rc = curses.wrapper(go)
    except KeyboardInterrupt:
        pass
    finally:
        global _stop
        _stop = True  # ends a finder thread still waiting for a target
    for out, secs, n in getattr(holder.get('ui'), 'saved', []):
        print(f'threadwatch: saved {secs:.0f} s ({n} samples) to {out}  ->  threadwatch summary {shlex.quote(out)}',
              file=sys.stderr)
    return rc


def main():
    ap = argparse.ArgumentParser(prog='threadwatch', description=__doc__.split('\n')[0],
                                 epilog='Run `threadwatch <command> -h` for options. '
                                        'Docs: https://github.com/JasonBurnsInfosec/threadwatch')
    sub = ap.add_subparsers(dest='cmd', required=True)
    r = sub.add_parser('record', help='sample a process (default: the running Steam game)')
    g = r.add_mutually_exclusive_group()
    g.add_argument('--pid', type=int, help='follow this process')
    r.add_argument('--name', help='regex on process name / argv0 basename')
    r.add_argument('--root', type=int, help='restrict search to descendants of this pid')
    r.add_argument('--appid', type=int, help='default mode: only this Steam game (when several are running)')
    r.add_argument('--also', action='append', metavar='REGEX', help='also record processes matching REGEX (repeatable)')
    r.add_argument('--syscalls', type=float, metavar='HZ', default=0, help='sample blocked-in syscalls at HZ (e.g. 1000)')
    r.add_argument('-o', '--out', default=f'threadwatch-{time.strftime("%Y%m%d-%H%M%S")}', help='output directory')
    r.add_argument('-i', '--interval', type=float, default=0.25, help='seconds between samples (default 0.25)')
    r.add_argument('-d', '--duration', type=float, default=0, help='stop after N seconds (0 = until exit)')
    r.add_argument('--wait', type=float, default=0, help='give up finding a target after N seconds (0 = forever)')
    s = sub.add_parser('summary', help='summarize a recording')
    s.add_argument('dir', help='directory written by record')
    s.add_argument('--window', help='window.json to restrict to (default: DIR/../window.json if present)')
    s.add_argument('--no-window', action='store_true', help='ignore window.json, summarize everything')
    s.add_argument('--from', dest='t_from', type=float, help='seconds since record start')
    s.add_argument('--to', dest='t_to', type=float, help='seconds since record start')
    s.add_argument('--fps', type=float, help='frame rate for per-frame figures (default: window.json avg_fps)')
    s.add_argument('--top', type=int, default=15, help='threads to list (default 15)')
    s.add_argument('--markdown', action='store_true', help='Markdown tables (for GitHub)')
    s.add_argument('--json', action='store_true', help='machine-readable summary')
    t = sub.add_parser(
        'top', help='live per-thread view in the terminal (default: the running Steam game)', formatter_class=argparse.RawDescriptionHelpFormatter,
        description='Live terminal view: per-core load grouped by L3 cache, a sortable thread table and an\n'
                    'inspector for the selected thread. Without --pid/--name/--root it follows the running\n'
                    'Steam game. Press r to record what you are watching (same files as `record`).',
        epilog="""keys:
  up/down, j/k, PgUp/PgDn, Home/End   select a thread
  s     cycle sort: cpu, peak, vol, invol, tid, name
  a     show all threads / only active ones
  p     pause / resume (space works too)
  + -   double / halve the refresh interval
  r     start / stop a recording (saved in --rec-dir; `threadwatch summary DIR` reads it)
  ?     explain every column
  q     quit (Esc works too; a running recording is saved first)

examples:
  threadwatch top                          the running Steam game (waits for one)
  threadwatch top --syscalls 1000          plus what the selected thread is blocked in
  threadwatch top --name 'Game\\.exe'       any process by name (non-Steam games, emulators...)
  threadwatch top --record --rec-dir ~/runs  record each game it follows, until it exits
  threadwatch top --pid 12345 -i 0.5""")
    t.add_argument('--pid', type=int, help='watch this process')
    t.add_argument('--name', help='regex on process name / argv0 basename (waits for it, follows restarts)')
    t.add_argument('--root', type=int, help='restrict search to descendants of this pid')
    t.add_argument('--appid', type=int, help='default mode: only this Steam game (when several are running)')
    t.add_argument('--also', action='append', metavar='REGEX', help='also show processes matching REGEX (repeatable)')
    t.add_argument('--syscalls', type=float, metavar='HZ', default=0,
                   help='sample what the selected, main and 2 busiest threads are blocked in (e.g. 1000)')
    t.add_argument('-i', '--interval', type=float, default=1.0, help='seconds between refreshes (default 1)')
    t.add_argument('--record', action='store_true', help='start recording as soon as a target is found (r toggles)')
    t.add_argument('--rec-dir', default='.', metavar='DIR', help='where r saves recordings (default: current directory)')
    t.add_argument('--rec-interval', type=float, default=0.25, metavar='SECS',
                   help='sampling interval of recordings (default 0.25, like record)')
    t.add_argument('--wait', type=float, default=0, help=argparse.SUPPRESS)
    a = ap.parse_args()
    if a.cmd in ('record', 'top') and a.appid and not is_auto(a):
        ap.error('--appid selects a Steam game in the default mode; it cannot be combined with --pid/--name/--root')
    if a.cmd == 'top':
        return cmd_top(a)
    return cmd_record(a) if a.cmd == 'record' else cmd_summary(a)


if __name__ == '__main__':
    sys.exit(main())
