SPARK = '▁▂▃▄▅▆▇█'
EIGHTHS = ' ▏▎▍▌▋▊▉█'
SORTS = ('cpu', 'peak', 'vol', 'invol', 'tid', 'name')


def parse_cpulist(s):
    """'0-1,16-17' -> {0, 1, 16, 17}."""
    out = set()
    for part in (s or '').split(','):
        a, _, b = part.strip().partition('-')
        try:
            out.update(range(int(a), int(b or a) + 1))
        except ValueError:
            pass
    return out


def spark(values, vmax):
    if not vmax:
        return ''
    return ''.join(SPARK[min(7, max(0, int(v / vmax * 7.999)))] for v in values)


def hbar(frac, width):
    """Horizontal bar of `width` cells with 1/8 resolution."""
    eighths = int(round(max(0.0, min(1.0, frac)) * width * 8))
    full, rem = divmod(eighths, 8)
    return ('█' * full + (EIGHTHS[rem] if rem else '')).ljust(width)


class LiveSyscalls(threading.Thread):
    """Like SyscallSampler, but keeps only the last `keep` seconds, for the live view."""

    def __init__(self, hz, keep=5):
        super().__init__(daemon=True)
        self.period, self.keep = 1.0 / hz, keep
        self.lock = threading.Lock()
        self.targets = []  # (pid, tid)
        self.buckets = deque()  # (sec, Counter{(tid, state): n})
        self.cls = Classifier()
        self.done = threading.Event()

    def set_targets(self, targets):
        with self.lock:
            self.targets = list(targets)

    def run(self):
        while not self.done.is_set():
            sec = int(time.monotonic())
            with self.lock:
                targets = self.targets
                if not self.buckets or self.buckets[-1][0] != sec:
                    self.buckets.append((sec, Counter()))
                    while self.buckets[0][0] <= sec - self.keep:
                        self.buckets.popleft()
                    if sec % 10 == 0:
                        self.cls.fd_cache.clear()  # fds get reused; don't keep stale types forever
                cur = self.buckets[-1][1]
            for pid, tid in targets:
                line = read(f'/proc/{pid}/task/{tid}/syscall')
                if line is not None:
                    state = self.cls.classify(pid, line)
                    with self.lock:
                        cur[(tid, state)] += 1
            time.sleep(self.period)

    def profile(self, tid):
        out = Counter()
        with self.lock:
            for _, b in self.buckets:
                for (t, state), n in b.items():
                    if t == tid:
                        out[state] += n
        return out


class LiveModel:
    """Samples the target (and --also processes) and keeps short per-thread histories."""
    HIST = 120

    def __init__(self, args):
        self.args = args
        self.interval = args.interval
        topo = topology()
        self.phys = {c: (v['package'], v['core_id']) for c, v in topo.items()}
        groups = defaultdict(list)
        for c, v in topo.items():
            groups[v['l3_group'] or '?'].append(c)
        self.l3 = sorted(groups.items(), key=lambda kv: min(kv[1]))
        perf = {c: int(v['cppc_highest_perf']) for c, v in topo.items() if (v['cppc_highest_perf'] or '').isdigit()}
        top = max(perf.values()) if perf else None
        # Preferred cores: the highest CPPC rank, if the firmware ranks cores at all.
        self.preferred = {c for c, p in perf.items() if p == top} if perf and len(set(perf.values())) > 1 else set()
        self.reset(None)

    def reset(self, pid):
        self.pid, self.comm, self.game = pid, '', None
        self.procs = {}
        self.prev_th, self.prev_c, self.prev_t = {}, cpu_times(), time.monotonic()
        self.hist = defaultdict(lambda: deque(maxlen=self.HIST))  # (pid, tid) -> (pct, cpu, vcs, nvcs)
        self.rows, self.core_busy = [], {}
        self.total_hist = deque(maxlen=self.HIST)
        self.also_cores = defaultdict(float)
        self.started, self.last_also, self.exited = time.monotonic(), 0.0, False
        if pid:
            st = read(f'/proc/{pid}/stat')
            self.comm = parse_stat(st)[0] if st else '?'
            self.game = game_label(pid)
            self.procs = {pid: 'target'}
            self.prev_th = {pid: thread_sample(pid) or {}}

    def window(self, secs=10):
        return max(1, int(round(secs / self.interval)))

    def sample(self):
        now = time.monotonic()
        if now - self.prev_t < 0.5 * self.interval:
            return  # just (re)started: a tiny dt turns one clock tick into thousands of percent
        if now - self.last_also >= 2.0:
            self.last_also = now
            for label, p in companions(self.args, self.pid):
                if p not in self.procs:
                    self.procs[p] = label
                    self.prev_th[p] = thread_sample(p) or {}
        samples = {p: thread_sample(p) for p in self.procs}
        if samples[self.pid] is None:
            self.exited = True
            return
        c = cpu_times()
        dt = max(1e-6, now - self.prev_t)
        for cpu, (busy, total) in c.items():
            pb, pt = self.prev_c.get(cpu, (busy, total))
            if total > pt:
                self.core_busy[cpu] = 100.0 * (busy - pb) / (total - pt)
        w = self.window()
        rows, seen = [], set()
        target_total = 0.0
        self.also_cores = defaultdict(float)
        for p, th in samples.items():
            if th is None:
                continue
            label = self.procs[p]
            for tid, s in th.items():
                q = self.prev_th.get(p, {}).get(tid)
                if q is None:
                    continue
                key = (p, tid)
                seen.add(key)
                pct = 100.0 * (s['ticks'] - q['ticks']) / CLK_TCK / dt
                vcs, nvcs = (s['vcs'] - q['vcs']) / dt, (s['nvcs'] - q['nvcs']) / dt
                h = self.hist[key]
                h.append((pct, s['cpu'], vcs, nvcs))
                recent = list(h)[-w:]
                busy = [(x[0], x[1]) for x in recent if x[0] > 1.0]
                migr = sum(1 for a, b in zip(busy, busy[1:]) if a[1] != b[1])
                span = len(recent) * self.interval
                rows.append({'key': key, 'pid': p, 'tid': tid, 'comm': s['comm'] or '(unnamed)', 'proc': label,
                             'state': s['state'], 'cpu': s['cpu'], 'pct': pct, 'vcs': vcs, 'nvcs': nvcs,
                             'allowed': s['allowed'], 'nallowed': len(parse_cpulist(s['allowed'])),
                             'avg': sum(x[0] for x in recent) / len(recent), 'peak': max(x[0] for x in recent),
                             'cores': Counter(x[1] for x in busy), 'migr': migr / span if span else 0.0})
                if label == 'target':
                    target_total += pct
                else:
                    self.also_cores[label] += pct / 100.0
        for key in list(self.hist):
            if key not in seen and key[0] not in samples:
                del self.hist[key]
        self.total_hist.append(target_total / 100.0)
        self.rows = rows
        self.prev_t, self.prev_c = now, c
        self.prev_th = {p: th for p, th in samples.items() if th is not None}

    def hottest(self):
        tgt = [r for r in self.rows if r['proc'] == 'target']
        return max(tgt, key=lambda r: r['avg']) if tgt else None


class RecThread(threading.Thread):
    """Runs a Recorder at its own interval for top's record key; closes it when stopped or the target exits."""

    def __init__(self, rec):
        super().__init__(daemon=True)
        self.rec, self.stop_evt, self.ended = rec, threading.Event(), None

    def run(self):
        try:
            while not self.stop_evt.wait(self.rec.interval):
                if not self.rec.step():
                    self.ended = 'the target exited'
                    break
        except Exception as e:  # keep what was recorded so far
            self.ended = f'{type(e).__name__}: {e}'
        finally:
            self.rec.close()


class TopUI:
