        self.sys = None
        if args.syscalls:
            self.sys = LiveSyscalls(args.syscalls)
            self.sys.start()
        self.init_colors()

    # -------------------------------------------------- setup
    def init_colors(self):
        c = self.c
        c.curs_set(0)
        self.scr.keypad(True)
        self.A = defaultdict(int)
        if not c.has_colors():
            self.A.update(sel=c.A_REVERSE, hdr=c.A_REVERSE, title=c.A_BOLD, key=c.A_BOLD)
            return
        c.start_color()
        try:
            c.use_default_colors()
            bg = -1
        except c.error:
            bg = c.COLOR_BLACK
        rich = c.COLORS >= 256
        spec = {  # name: (256-colour fg, bg, 8-colour fg, bg, extra attr)
            'border': (208, bg, c.COLOR_YELLOW, bg, 0),
            'title': (231, bg, c.COLOR_WHITE, bg, c.A_BOLD),
            'dim': (244, bg, c.COLOR_WHITE, bg, 0 if rich else c.A_DIM),
            'green': (112, bg, c.COLOR_GREEN, bg, 0),
            'yellow': (220, bg, c.COLOR_YELLOW, bg, 0),
            'red': (203, bg, c.COLOR_RED, bg, 0),
            'cyan': (75, bg, c.COLOR_CYAN, bg, 0),
            'magenta': (170, bg, c.COLOR_MAGENTA, bg, 0),
            'orange': (214, bg, c.COLOR_YELLOW, bg, c.A_BOLD),
            'hdr': (231, 238, c.COLOR_BLACK, c.COLOR_WHITE, c.A_BOLD),
            'sel': (231, 25, c.COLOR_WHITE, c.COLOR_BLUE, c.A_BOLD),
            'zebra': (252, 235, c.COLOR_WHITE, bg, 0),
            'mask': (16, 220, c.COLOR_BLACK, c.COLOR_YELLOW, c.A_BOLD),
            'key': (208, bg, c.COLOR_YELLOW, bg, c.A_BOLD),
        }
        for i, (name, (f256, b256, f8, b8, extra)) in enumerate(spec.items(), 1):
            if rich:
                c.init_pair(i, f256, b256)
            else:
                c.init_pair(i, f8, b8 if b8 != 238 else bg)
            self.A[name] = c.color_pair(i) | extra

    # -------------------------------------------------- drawing helpers
    def put(self, y, x, s, attr=0, width=None):
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return x
        s = str(s)
        right = min(w, self.xmax) if self.xmax else w
        room = min(right - x, width if width is not None else right - x)
        s = s[:max(0, room)]
        try:
            self.scr.addstr(y, x, s, attr)
        except self.c.error:
            pass  # writing the bottom-right cell raises after the write succeeds
        return x + len(s)

    def box(self, y, x, h, w, title=''):
        a = self.A['border']
        self.put(y, x, '╭' + '─' * (w - 2) + '╮', a)
        for i in range(1, h - 1):
            self.put(y + i, x, '│', a)
            self.put(y + i, x + w - 1, '│', a)
        self.put(y + h - 1, x, '╰' + '─' * (w - 2) + '╯', a)
        if title:
            self.put(y, x + 2, f' {title} ', self.A['cyan'])

    def load_attr(self, pct):
        return self.A['red'] if pct >= 85 else self.A['yellow'] if pct >= 50 else self.A['green']

    # -------------------------------------------------- target lifecycle
    def start_finder(self):
        args = self.args
        if args.pid:
            self.found = args.pid
            return
        def run():
            try:
                self.found = find_target(args)
            except Exception as e:  # never let a traceback scribble over the screen
                self.status = f'target search failed: {type(e).__name__}: {e}'
                self.found = -1
                return
            if self.found is None and not _stop:
                self.found = -1
        self.found = None
        self.finder = threading.Thread(target=run, daemon=True)
        self.finder.start()

    def poll_target(self):
        m = self.model
        if m.pid and not m.exited:
            return
        if m.pid and m.exited:
            if self.args.pid or self.found == -1:
                return  # nothing to wait for: keep the last frame
            self.status = f'{m.comm} ({m.pid}) exited; ' + ('waiting for the next game' if is_auto(self.args) else 'waiting for the next match')
            m.reset(None)
            self.start_finder()
        if self.found and self.found > 0 and not m.pid:
            if read(f'/proc/{self.found}/stat'):
                m.reset(self.found)
                self.status = ''
                if self.args.record:
                    self.start_recording()
            else:
                self.status = f'pid {self.found} not found'
                self.found = -1

    # -------------------------------------------------- views
    def visible_rows(self):
        m = self.model
        rows = m.rows
        if not self.show_all:
            rows = [r for r in rows if r['peak'] >= 0.5 or r['tid'] == m.pid or r['key'] == self.sel_key]
        key = {'cpu': lambda r: (-r['pct'], -r['avg']), 'peak': lambda r: -r['peak'], 'vol': lambda r: -r['vcs'],
               'invol': lambda r: -r['nvcs'], 'tid': lambda r: (r['proc'] != 'target', r['tid']),
               'name': lambda r: (r['comm'].lower(), r['tid'])}[self.sort]
        return sorted(rows, key=key)

    def notes(self, r, hot):
        m, out = self.model, []
        if r['tid'] == m.pid:
            out.append('main')
        if r['nallowed'] and r['nallowed'] < NCPU:
            out.append(f"pinned:{r['nallowed']}")
        if hot and r is not hot and r['proc'] == 'target' and hot['nallowed'] < NCPU and r['allowed'] == hot['allowed']:
            out.append('hot-mask')
        if r['avg'] > 80 and r['vcs'] > 1000:
            out.append('spin?')
        return ' '.join(out)

    def draw_header(self, y, w):
        m, A = self.model, self.A
        hot = m.hottest()
        hot_mask = parse_cpulist(hot['allowed']) if hot and hot['nallowed'] < NCPU else set()
        cell = 10 if w >= 20 + 8 * 10 else 4  # "NN ▕bar▏" or "NN▆"
        lines = 3 + len(m.l3)
        self.box(y, 0, lines + 2, w, 'threadwatch')
        if m.pid and m.game:
            self.put(y, 15, f' {m.game} '[:max(0, w - 18)], A['orange'])
        x = 2
        r1 = y + 1
        if not m.pid:
            if is_auto(self.args):
                want = f'Steam app {self.args.appid}' if self.args.appid else 'a Steam game'
                wait = f'waiting for {want} to start (or run with --pid / --name for any process)...'
            else:
                wait = f"waiting for a process matching {self.args.name or 'the busiest descendant'}..."
            self.put(r1, x, self.status or wait, A['yellow'])
            if self.status:
                self.put(r1 + 1, x, wait, A['dim'])
            return y + lines + 2
        busy = m.total_hist[-1] if m.total_hist else 0.0
        el = int(time.monotonic() - m.started)
        tail = ('PAUSED  ' if self.paused else '') + f'{self.model.interval:g}s  {el // 60}:{el % 60:02d}'
        self.put(r1, w - 2 - len(tail), tail, A['orange'] if self.paused else A['dim'])
        if self.rec:
            rs = int(self.rec.rec.elapsed())
            rec_s = f'● REC {rs // 60}:{rs % 60:02d}  '
            tail = rec_s + tail
            self.put(r1, w - 2 - len(tail), rec_s, A['red'] | self.c.A_BOLD)
        self.xmax = w - 4 - len(tail)  # row 1 content stops before the tail
        x = self.put(r1, x, m.comm, A['title'])
        x = self.put(r1, x, f'  pid {m.pid}', A['dim'])
        nthreads = sum(1 for r in m.rows if r['proc'] == 'target')
        x = self.put(r1, x, f'  {nthreads} threads  ')
        x = self.put(r1, x, f'{busy:.2f}', A['title'])
        x = self.put(r1, x, f' of {NCPU} cores busy  ')
        # Fixed scale: 0 to the peak over the whole history, rounded up to whole cores. Scaling to the visible
        # max drew a steady load (e.g. 1.42 cores) as a solid full-height bar.
        peak = max(m.total_hist, default=0.0)
        scale = max(1, int(-(-peak // 1)))
        peak_s = f'  peak {peak:.2f}  (0-{scale} cores)'
        also = sorted(m.also_cores.items())
        room = self.xmax - x - len(peak_s) - sum(len(f'  {label} 0.00') for label, _ in also)
        hist = list(m.total_hist)[-max(4, min(60, room)):]
        x = self.put(r1, x, spark(hist, scale), A['green'])
        x = self.put(r1, x, peak_s, A['dim'])
        for label, cores in also:
            x = self.put(r1, x, f'  {label} ', A['dim'])
            x = self.put(r1, x, f'{cores:.2f}', A['magenta'])
        self.xmax = None
        r2 = y + 2
        if hot:
            x = self.put(r2, 2, 'hottest ', A['dim'])
            x = self.put(r2, x, f"{hot['comm']} ({hot['tid']})", A['title'])
            x = self.put(r2, x, f"  {hot['avg']:.0f}% avg 10s  on CPU {hot['cpu']}  allowed ")
            x = self.put(r2, x, hot['allowed'], A['mask'] if hot_mask else A['dim'])
            if hot_mask:
                sharers = sum(1 for r in m.rows if r is not hot and r['proc'] == 'target' and r['allowed'] == hot['allowed'])
                self.put(r2, x, f'  {sharers} other thread(s) share this mask', A['yellow'] if sharers else A['dim'])
        for i, (group, cpus) in enumerate(m.l3):
            ry = y + 3 + i
            x = self.put(ry, 2, f'L3 {group}'[:16].ljust(17), A['cyan'])
            for cpu in sorted(cpus):
                pct = m.core_busy.get(cpu, 0.0)
                num_attr = A['mask'] if cpu in hot_mask else A['dim']
                if hot and cpu == hot['cpu']:
                    num_attr |= self.c.A_UNDERLINE | self.c.A_BOLD
                x = self.put(ry, x, f'{cpu:>2}', num_attr)
                x = self.put(ry, x, '*' if cpu in m.preferred else ' ', A['orange'])
                if cell == 10:
                    x = self.put(ry, x, hbar(pct / 100, 5), self.load_attr(pct))
                    x = self.put(ry, x, '  ')
                else:
                    x = self.put(ry, x, SPARK[min(7, int(pct / 100 * 7.999))], self.load_attr(pct))
        ry = y + 3 + len(m.l3)
        x = self.put(ry, 2, 'bars: system-wide busy per logical CPU   ', A['dim'])
        if hot_mask:
            x = self.put(ry, x, ' N ', A['mask'])
            x = self.put(ry, x, " hottest thread's allowed CPUs   ", A['dim'])
        x = self.put(ry, x, 'underlined: it runs there now', A['dim'])
        if m.preferred:
            self.put(ry, x, '   * preferred (CPPC) cores', A['dim'])
        return y + lines + 2

    COLS = [('TID', 7, '>'), ('Thread', 18, '<'), ('Proc', 10, '<'), ('S', 1, '<'), ('CPU%', 6, '>'), ('', 10, '<'),
            ('Peak', 5, '>'), ('CPU', 3, '>'), ('Cores', 5, '>'), ('Migr/s', 6, '>'), ('Vol/s', 7, '>'),
            ('Invol/s', 7, '>'), ('Allowed', 12, '<'), ('Notes', 0, '<')]

    def draw_table(self, y, h, w, rows):
        m, A = self.model, self.A
        cols = [c for c in self.COLS if c[0] != 'Proc' or any(r['proc'] != 'target' for r in m.rows)]
        hot = m.hottest()
        x = 0
        self.put(y, 0, ' ' * w, A['hdr'])
        for name, width, align in cols:
            label = name + ('▼' if (name, self.sort) in (('CPU%', 'cpu'), ('Peak', 'peak'), ('Vol/s', 'vol'),
                                                          ('Invol/s', 'invol'), ('TID', 'tid'), ('Thread', 'name')) else '')
            width = width or max(0, w - x - 1)
            x = self.put(y, x + 1, label.rjust(width) if align == '>' else label.ljust(width), A['hdr'])
        body = h - 1
        if not rows:
            self.put(y + 1, 2, 'no thread samples yet' if m.pid else '', A['dim'])
            return
        keys = [r['key'] for r in rows]
        if self.sel_key not in keys:
            self.sel_key = keys[0]
        si = keys.index(self.sel_key)
        self.offset = min(max(self.offset, si - body + 1), si, max(0, len(rows) - body))
        self.offset = max(0, self.offset)
        for i, r in enumerate(rows[self.offset:self.offset + body]):
            ry = y + 1 + i
            selected = r['key'] == self.sel_key
            base = A['sel'] if selected else (A['zebra'] if i % 2 else 0)
            self.put(ry, 0, ' ' * w, base)
            x = 0
            for name, width, align in cols:
                width = width or max(0, w - x - 1)
                attr = base
                if name == 'TID':
                    v = r['tid']
                elif name == 'Thread':
                    v = r['comm']
                    attr = base | (self.c.A_BOLD if r['tid'] == m.pid else 0)
                elif name == 'Proc':
                    v = r['proc']
                    attr = base if selected or r['proc'] == 'target' else A['magenta']
                elif name == 'S':
                    v = r['state']
                    attr = base if selected or v != 'R' else A['green']
                elif name == 'CPU%':
                    v = f"{r['pct']:.1f}"
                    attr = base if selected else self.load_attr(r['pct']) | self.c.A_BOLD
                elif name == '':
                    v = hbar(r['pct'] / 100, width)
                    attr = base if selected else self.load_attr(r['pct'])
                elif name == 'Peak':
                    v = f"{r['peak']:.0f}"
                elif name == 'CPU':
                    v = r['cpu']
                elif name == 'Cores':
                    v = len(r['cores'])
                elif name == 'Migr/s':
                    v = f"{r['migr']:.1f}"
                elif name == 'Vol/s':
                    v = f"{r['vcs']:.0f}"
                elif name == 'Invol/s':
                    v = f"{r['nvcs']:.0f}"
                    attr = base if selected or r['nvcs'] < 100 else A['yellow']
                elif name == 'Allowed':
                    v = r['allowed']
                    attr = base if selected or r['nallowed'] >= NCPU else A['yellow']
                else:
                    v = self.notes(r, hot)
                    attr = base if selected else A['orange']
                v = str(v)[:width]
                x = self.put(ry, x + 1, v.rjust(width) if align == '>' else v.ljust(width), attr)
        if len(rows) > body:
            self.put(y, w - 12, f' {self.offset + 1}-{min(len(rows), self.offset + body)}/{len(rows)} ', A['hdr'])

    def draw_inspector(self, y, h, w, r):
        m, A = self.model, self.A
        title = f"{r['comm']} ({r['tid']})" + ('' if r['proc'] == 'target' else f" - {r['proc']}") if r else 'no thread selected'
        self.box(y, 0, h, w, title)
        if not r:
            return
        x0, ry = 2, y + 1
        x = self.put(ry, x0, 'CPU ', A['dim'])
        x = self.put(ry, x, f"{r['pct']:.1f}%", self.load_attr(r['pct']) | self.c.A_BOLD)
        x = self.put(ry, x, f"   avg 10s {r['avg']:.1f}%   peak {r['peak']:.0f}%   state {r['state']}   on CPU {r['cpu']}   ")
        x = self.put(ry, x, f"vol {r['vcs']:.0f}/s  invol {r['nvcs']:.0f}/s   allowed ", A['dim'])
        self.put(ry, x, f"{r['allowed']} ({r['nallowed']} CPUs)", A['yellow'] if r['nallowed'] < NCPU else 0)
        ry += 1
        hist = [p[0] for p in m.hist.get(r['key'], ())][-(w - 20):]
        x = self.put(ry, x0, f"last {len(hist) * m.interval:.0f}s".ljust(11), A['dim'])
        x = self.put(ry, x, spark(hist, 100.0), self.load_attr(r['avg']))
        self.put(ry, x, '  (0-100%)', A['dim'])
        ry += 1
        x = self.put(ry, x0, 'cores 10s'.ljust(11), A['dim'])
        tot = sum(r['cores'].values())
        if tot:
            parts = r['cores'].most_common(6)
            for cpu, n in parts:
                x = self.put(ry, x, f'{cpu}', A['cyan'])
                x = self.put(ry, x, f' {100 * n / tot:.0f}%  ')
            physs = {m.phys.get(c) for c in r['cores']}
            groups = {g for g, cpus in m.l3 if set(r['cores']) & set(cpus)}
            self.put(ry, x, f"  {len(physs)} physical core(s), {len(groups)} L3 group(s), {r['migr']:.1f} migrations/s", A['dim'])
        else:
            self.put(ry, x, 'idle (no samples above 1% CPU)', A['dim'])
        ry += 1
        x = self.put(ry, x0, 'blocked in'.ljust(11), A['dim'])
        if not self.sys:
            self.put(ry, x, 'start with --syscalls 1000 to see what this thread waits on (futex, ntsync, wineserver...)', A['dim'])
        else:
            prof = self.sys.profile(r['tid'])
            tot = sum(prof.values())
            if tot < 20:
                self.put(ry, x, 'sampling...', A['dim'])
            else:
                for state, n in prof.most_common(5):
                    x = self.put(ry, x, f'{100 * n / tot:.0f}% ', A['title'])
                    x = self.put(ry, x, f'{state}   ', A['green'] if state == 'running' else A['cyan'])
                self.put(ry, x, f'(last {self.sys.keep}s, {tot} samples)', A['dim'])
        ry += 1
        hints = []
        hot = m.hottest()
        if r is hot and r['avg'] > 90 and (m.total_hist[-1] if m.total_hist else 0) < 3:
            hints.append('near 100% while few cores are busy: likely the bottleneck')
        if hot and r is not hot and r['proc'] == 'target' and hot['nallowed'] < NCPU and r['allowed'] == hot['allowed']:
            hints.append(f"shares the hottest thread's mask {hot['allowed']}: it competes with that thread "
                         '(threads inherit the mask of the thread that created them)')
        if r['avg'] > 80 and r['vcs'] > 1000:
            hints.append('busy with >1000 voluntary switches/s: possible spin or yield loop')
        if r['nvcs'] > 200:
            hints.append('many involuntary switches: preempted, the CPUs it may use are contended')
        if hints and ry < y + h - 1:
            self.put(ry, x0, 'hints', A['dim'])
            self.put(ry, x0 + 11, '; '.join(hints), A['orange'])

    def draw_footer(self, y, w):
        A = self.A
        self.put(y, 0, ' ' * w, A['hdr'])
        keys = [('q', 'Quit'), ('s', f'Sort:{self.sort}'), ('a', 'All' if self.show_all else 'Active'),
                ('p', 'Resume' if self.paused else 'Pause'), ('r', 'Stop rec' if self.rec else 'Record'),
                ('↑↓', 'Select'), ('+/-', 'Interval'), ('?', 'Explain')]
        hidden = len(self.model.rows) - len(self.visible_rows())
        msg = f'{hidden} idle threads hidden ' if hidden > 0 else ''
        if self.notice and time.monotonic() < self.notice[1]:
            msg = f'{self.notice[0]}   {msg}'
        width = lambda ks: 1 + sum(len(k) + len(label) + 3 for k, label in ks)
        if msg and width(keys) + len(msg) + 1 > w:  # a message wins over the less important key hints
            keys = [kv for kv in keys if kv[0] in ('q', 'r', '?')]
        x = 1
        for k, label in keys:
            x = self.put(y, x, k, A['key'])
            x = self.put(y, x, f' {label}  ', A['hdr'])
        if msg:
            self.put(y, max(x, w - len(msg) - 1), msg, A['hdr'])

